# =============================================================
# VARIABLES DE ENTORNO — Conexión Odoo → Power BI
# =============================================================
# Copiá este archivo como .env y completá con tus credenciales.
# NUNCA subas el archivo .env a GitHub.
#
# Cómo generar la API Key en Odoo:
#   Ajustes → Seguridad → Claves API → Nueva clave
# =============================================================

ODOO_URL=https://tu-instancia.odoo.com
ODOO_DB=nombre-de-tu-base-de-datos
ODOO_USERNAME=tu-email@ejemplo.com
ODOO_API_KEY=tu-api-key-aqui
